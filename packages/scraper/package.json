{
	"name": "@qnaplus/scraper",
	"version": "3.1.7",
	"description": "Utility package to scrape questions from the VEX Robotics Q&A.",
	"main": "dist/index.js",
	"repository": {
		"url": "git+ssh://git@github.com/qnaplus/scraper.git"
	},
	"author": "battlesquid <25509915+battlesquid@users.noreply.github.com>",
	"license": "GPL-3.0",
	"scripts": {
		"build": "tsc",
		"build:clean": "pnpm clean && pnpm build",
		"test": "vitest --run",
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"reset": "pnpm clean && rm -rf node_modules",
		"lint": "oxlint src",
		"lint:fix": "oxlint --fix src",
		"fmt": "oxfmt --check src",
		"fmt:fix": "oxfmt src"
	},
	"dependencies": {
		"@crawlee/core": "^3.16.0",
		"cheerio": "^1.2.0",
		"got-scraping": "^4.2.1",
        "pdfjs-dist": "^5.7.284",
		"pino": "catalog:"
	},
	"devDependencies": {
		"@qnaplus/typescript-config": "workspace:*",
		"pino-pretty": "catalog:",
		"vitest": "^4.1.6"
	},
	"volta": {
		"extends": "../../package.json"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"default": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	}
}
